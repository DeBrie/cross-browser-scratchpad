{
  "manifest_version": 3,
  "name": "Scratchpad",
  "description": "A tiny Markdown scratchpad for everywhere, this site, or this window.",
  "version": "1.1.1",
  "permissions": ["storage", "tabs", "sidePanel"],
  "host_permissions": ["https://scratchpad-sync.james-allen1994back.workers.dev/*"],
  "action": {
    "default_title": "Open Scratchpad",
    "default_popup": "src/index.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/index.html"
  }
}
