{
  "manifest_version": 3,
  "name": "Scratchpad",
  "version": "1.1.1",
  "description": "Encrypted local-first Markdown notes.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://scratchpad-sync.james-allen1994back.workers.dev/*"],
  "action": { "default_popup": "src/index.html" },
  "browser_specific_settings": { "gecko": { "id": "scratchpad@local", "strict_min_version": "121.0" } }
}
